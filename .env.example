# ==============================================================================
# Expense Tracker - Environment Configuration Example
# ==============================================================================
# This project consists of two applications:
# 1. Backend (`backend/`) - Node.js/Express with Neon PostgreSQL & Upstash Redis
# 2. Mobile  (`mobile/`)  - React Native / Expo with Clerk Auth
#
# Follow the instructions below to create .env files for each service.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (.env in `backend/.env`)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# Neon Serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require

# Upstash Redis REST credentials (used by @upstash/redis & @upstash/ratelimit)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Keep-Alive URL for production cron job
API_URL=http://localhost:5001/api/health

# Clerk Authentication (keys from https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ------------------------------------------------------------------------------
# 2. MOBILE APP (.env in `mobile/.env`)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Expo requires EXPO_PUBLIC_ prefix to expose to client)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: Custom API URL (see mobile/constants/api.js)
EXPO_PUBLIC_API_URL=http://localhost:5001/api
