# ==========================================
# Mobile Environment Variables (Expo)
# ==========================================

# Clerk Publishable Key (Required for authentication)
# Obtain this from your Clerk Dashboard: https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API URL (Production or Local)
# Production: https://expense-tracker-v2qb.onrender.com/api
# Local Dev:   http://localhost:5001/api
EXPO_PUBLIC_API_URL=https://expense-tracker-v2qb.onrender.com/api
