# ==========================================
# Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database (Neon Serverless PostgreSQL Connection String)
# Example: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require

# Upstash Redis (Used by @upstash/redis & @upstash/ratelimit)
# Obtain these from your Upstash Console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
# Note: REDIS_URL can also be defined if required by your setup:
# REDIS_URL=rediss://default:password@endpoint:port

# Health Check / Keep-Alive Ping URL (used by production cron job)
API_URL=http://localhost:5001/api/health

# Clerk Authentication (Optional / Backend verification)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

